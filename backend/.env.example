# Copia este archivo como ".env" y ajusta los valores.

# --- General ---
SECRET_KEY=cambia-esta-clave-por-una-generada-aleatoriamente
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,192.168.0.0/16
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Autenticación LDAP / Active Directory (dejar vacío para usar solo usuarios locales) ---
AUTH_LDAP_SERVER_URI=
AUTH_LDAP_BIND_DN=
AUTH_LDAP_BIND_PASSWORD=
AUTH_LDAP_USER_SEARCH_BASE=dc=universidad,dc=edu
AUTH_LDAP_GROUP_SEARCH_BASE=dc=universidad,dc=edu

# Nombres CN reales de los grupos de seguridad en tu Active Directory,
# mapeados a los 4 roles del sistema (ajusta a tu organización):
AD_GROUP_ADMIN=TI-Administradores
AD_GROUP_AUDITOR=TI-Auditores
AD_GROUP_DIRECTOR=TI-Directores
AD_GROUP_TECNICO=TI-Tecnicos

# --- Notificaciones por correo ---
# Si EMAIL_HOST se deja vacío, los correos solo se imprimen en la consola (modo desarrollo).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=reportes-ti@universidad.edu
# Correo(s) del equipo técnico que reciben aviso de nuevos reportes (separados por coma)
NOTIFICAR_NUEVOS_REPORTES_A=soporte-ti@universidad.edu
